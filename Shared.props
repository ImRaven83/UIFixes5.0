<Project>
  <PropertyGroup>
    <Version>7.0.7</Version>
    <SPTPath>$(MSBuildThisFileDirectory)..\..\..\..\SPT\5.0</SPTPath>
    <LibsPath>$(MSBuildThisFileDirectory)libs</LibsPath>
    <AssemblySearchPaths>
      $(SPTPath)\BepInEx\interop;
      $(SPTPath)\BepInEx\core;
      $(SPTPath)\BepInEx\plugins\spt;
      $(LibsPath)\managed;
      $(LibsPath)\core;
      $(LibsPath)\spt;
      $(AssemblySearchPaths)
    </AssemblySearchPaths>
  </PropertyGroup>

  <Import Project="Shared.props.user" Condition="Exists('Shared.props.user')" />

  <ItemGroup>
    <DeployTarget Include="Default">
      <Path>$(SPTPath)</Path>
    </DeployTarget>
    <DeployTarget Include="Release" Condition="'$(Configuration)'=='Release'">
      <Path>$(MSBuildThisFileDirectory)dist</Path>
    </DeployTarget>
  </ItemGroup>

  <Target Name="SPTClientDeploy" AfterTargets="PostBuildEvent" Condition="'$(SPTModType)'=='Client' And '$(OS)'=='Windows_NT'">
    <Exec
      Command='
        xcopy /F /Y "$(TargetPath)" "%(DeployTarget.Path)\BepInEx\plugins\"

        if $(ConfigurationName) == Debug (
          xcopy /F /Y "$(ProjectDir)$(OutDir)$(TargetName).pdb" "%(DeployTarget.Path)\BepInEx\plugins\"
        )'
    />
  </Target>

  <Target Name="SPTServerDeploy" AfterTargets="PostBuildEvent" Condition="'$(SPTModType)'=='Server' And '$(OS)'=='Windows_NT'">
    <Exec
      Command='
        xcopy /F /Y "$(TargetPath)" "%(DeployTarget.Path)\SPT_Runtime\user\mods\$(TargetName)\"

        if $(ConfigurationName) == Debug (
          xcopy /F /Y "$(ProjectDir)$(OutDir)$(TargetName).pdb" "%(DeployTarget.Path)\SPT_Runtime\user\mods\$(TargetName)\"
        )'
    />
  </Target>

</Project>