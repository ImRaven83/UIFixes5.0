<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="..\Shared.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Tyfon.UIFixes.Server</AssemblyName>
    <OutputType>Library</OutputType>
    <SPTModType>Server</SPTModType>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Configurations>Debug;Release</Configurations>
    <AssemblySearchPaths>
      $(SPTPath)\SPT_Runtime;
      $(LibsPath)\server;
      $(AssemblySearchPaths)
    </AssemblySearchPaths>
  </PropertyGroup>

  <ItemGroup>
    <!-- SPT 5.0 server assemblies are not on NuGet; they resolve from the SPT install or libs\server -->
    <Reference Include="SemanticVersioning" Private="false" />
    <Reference Include="SPTarkov.Common" Private="false" />
    <Reference Include="SPTarkov.DI" Private="false" />
    <Reference Include="SPTarkov.Reflection" Private="false" />
    <Reference Include="SPTarkov.Server.Core" Private="false" />
    <PackageReference Include="HarmonyX" Version="2.16.1" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>